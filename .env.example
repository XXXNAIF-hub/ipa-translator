# Local neural MT (Transformers.js / NLLB-200) is the DEFAULT — no keys, no cloud quota.
# First run downloads Xenova/nllb-200-distilled-600M into .cache/ (~870MB once).

# Optional: override model cache directory (default: <project>/.cache)
# TRANSFORMERS_CACHE=

# Optional secondary: self-hosted or paid LibreTranslate instance
# (used only when set; never required for default local translation)
# TRANSLATE_API_URL=http://127.0.0.1:5000
# TRANSLATE_API_KEY=
