# Optional: LibreTranslate base URL (default: https://libretranslate.com)
# Self-host or use a public instance. Trailing slash optional.
TRANSLATE_API_URL=https://libretranslate.com

# Optional: API key if your LibreTranslate instance requires one
TRANSLATE_API_KEY=

# Optional: email for MyMemory free API (higher soft quota when provided)
# https://mymemory.translated.net/
MYMEMORY_EMAIL=

# Delay in ms between translation API calls (rate-limit friendly)
TRANSLATE_DELAY_MS=300
